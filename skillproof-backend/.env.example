PROJECT_NAME="SkillProof Backend API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Authentication
JWT_SECRET="skillproof-development-super-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Async PostgreSQL asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skillproof_db

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# External Integrations (Optional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
